# Loom Payment Orchestration Layer - Environment Configuration

# Server Configuration
PORT=8080
ENVIRONMENT=development  # development, staging, production
BASE_URL=http://localhost:8080

# Database Configuration (optional - uses in-memory store if not set)
DATABASE_URL=postgres://user:password@localhost:5432/loom?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=  # Optional, uses secret key if not set
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ENABLED=true
PAYSTACK_TIMEOUT=30s

# Flutterwave Configuration
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=  # For card encryption
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_TIMEOUT=30s

# Orchestration Settings
PROVIDER_PRIORITY=paystack,flutterwave  # Comma-separated, first is highest priority
FAILOVER_ENABLED=true

# Circuit Breaker Settings
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_TIMEOUT=30s
CIRCUIT_BREAKER_HALF_OPEN=3

# Idempotency Settings
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_DURATION=30s
IDEMPOTENCY_CLEANUP_INTERVAL=1h

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text
